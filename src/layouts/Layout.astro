---
import "../styles/global.css";
import GlassHeader from "@/components/GlassHeader";
import PageNav from "@/components/PageNav";
import Footer from "@/components/Footer";
import { pages } from "@/lib/navigation";
import { personalInfo } from "@/lib/data";

interface Props {
  /** Slug de la page courante, vide pour l'accueil. */
  slug: string;
}

const { slug } = Astro.props;
const page = pages.find((entry) => entry.slug === slug);

if (!page) {
  throw new Error(
    `Slug inconnu : "${slug}". Ajoutez la page dans src/lib/navigation.ts.`,
  );
}

const title = slug
  ? `${page.title} – ${personalInfo.name}`
  : `${personalInfo.name} – ${personalInfo.title}`;

const baseUrl = import.meta.env.BASE_URL ?? "/";
const normalizedBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${normalizedBase}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={page.description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-background font-sans antialiased selection:bg-brand-muted"
  >
    <div
      class="fixed inset-0 -z-10 bg-background bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,var(--brand-muted),transparent)]"
    >
    </div>

    <GlassHeader client:only="react" current={slug} />

    <main class="pt-16">
      <slot />
    </main>

    <PageNav client:only="react" current={slug} />
    <Footer client:only="react" />
  </body>
</html>

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<style>
  :root {
    --transition-standard: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body {
    transition:
      background-color var(--transition-standard),
      color var(--transition-standard);
  }
</style>
