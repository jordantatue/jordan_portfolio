---
import "../styles/workspace.css";
import { profile } from "@/lib/portfolio";

const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site ?? "https://jordantatue.github.io").toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08111d" />
    <meta name="description" content="Portfolio de Jordan Tatue, ingénieur logiciel en développement Full Stack, DevOps et IA. Expériences, projets et compétences." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{profile.name} — Full Stack, DevOps & IA</title>
    <meta property="og:title" content="Jordan Tatue — Full Stack, DevOps & IA" />
    <meta property="og:description" content="Applications métier, automatisation des livraisons et IA appliquée." />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
  </body>
</html>
